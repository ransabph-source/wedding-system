# Copy to .env.local and fill in from your Supabase project (see README).
# All are read only on the server; never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Used for admin sign-in sessions (Project Settings → API Keys → Publishable key).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Messaging service that sends guests their RSVP links (Guest List → שליחת הודעות).
# Receives a JSON POST with the event and recipients (name, phone, rsvpUrl).
WEBHOOK_URL=https://example.com/your-webhook
# Public address of this app, used to build the RSVP links sent to guests.
# Falls back to the address the dashboard is opened on.
APP_URL=https://your-app.example.com
# WhatsApp Cloud API (Meta). WEBHOOK_VERIFY_TOKEN is any secret string you also
# enter as the "Verify token" when subscribing the webhook at /api/webhook.
WEBHOOK_VERIFY_TOKEN=choose-a-random-string
# App settings → Basic → App secret; used to verify incoming webhook POSTs.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# The sending number's Phone number ID (WhatsApp → API Setup), not the number.
WHATSAPP_PHONE_ID=
WHATSAPP_ACCOUNT_ID=
