# Copy to .env.local and fill in from your Supabase project (see README).
# All are read only on the server; never prefix them with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Used for admin sign-in sessions (Project Settings → API Keys → Publishable key).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Public address of this app, used to build the RSVP links sent to guests.
# Falls back to the address the dashboard is opened on.
APP_URL=https://your-app.example.com
# WhatsApp Cloud API (Meta). WHATSAPP_VERIFY_TOKEN is any secret string you also
# enter as the "Verify token" when subscribing the webhook at /api/webhook.
# (The older name WEBHOOK_VERIFY_TOKEN is still read if this one isn't set.)
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# App settings → Basic → App secret; used to verify incoming webhook POSTs.
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
# The sending number's Phone number ID (WhatsApp → API Setup), not the number.
WHATSAPP_PHONE_ID=
WHATSAPP_ACCOUNT_ID=
# Approved message template for RSVP invitations (Guest List → שליחת הודעות).
# Its body must take 5 variables: {{1}} guest name, {{2}} couple names,
# {{3}} event date, {{4}} venue, {{5}} the guest's personal RSVP link.
WHATSAPP_RSVP_TEMPLATE=
# The template's language code in WhatsApp Manager; defaults to "he".
WHATSAPP_RSVP_TEMPLATE_LANGUAGE=he
# Optional template for the automated reminders (T-21, T-18), with the same 5
# variables. Without it the reminders resend WHATSAPP_RSVP_TEMPLATE.
WHATSAPP_RSVP_REMINDER_TEMPLATE=
# Defaults to WHATSAPP_RSVP_TEMPLATE_LANGUAGE.
WHATSAPP_RSVP_REMINDER_TEMPLATE_LANGUAGE=
# Hourly RSVP automation (/api/cron/rsvp-automation, scheduled in vercel.json).
# Vercel Cron sends CRON_SECRET as a Bearer token; use a random string of at
# least 16 characters.
CRON_SECRET=
# Admin number(s) for the daily automation reports, e.g. 0501234567;
# separate several with commas.
ADMIN_WHATSAPP_NUMBER=
# Plain texts only reach an admin who messaged the business number in the
# last 24 hours. For reliable daily reports, approve a template whose body is
# just {{1}} (the report text) and name it here.
ADMIN_WHATSAPP_TEMPLATE=
# The admin template's language code; defaults to "en".
ADMIN_WHATSAPP_TEMPLATE_LANGUAGE=en
# OpenAI API key for the AI seating assistant (/api/ai-seating). Each event
# may make 30 requests.
OPENAI_API_KEY=
